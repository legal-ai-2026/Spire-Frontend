# C2D2 Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# App
# =============================================================================
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# Database
# PostgreSQL is required for shared/staging deployments.
# =============================================================================
DATABASE_URL=postgresql+psycopg2://c2d2:c2d2local@localhost:5432/c2d2
# DATABASE_URL=postgresql+psycopg2://user:password@postgres-pgvector.graph-stack.svc.cluster.local:5432/c2d2?sslmode=disable

# =============================================================================
# Security
# =============================================================================
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRE_HOURS=168

# Default admin user (created on first run if no users exist)
DEFAULT_ADMIN_EMAIL=admin@c2d2.local
DEFAULT_ADMIN_PASSWORD=changeme123

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# AI — Anthropic Claude (Phase 01 scoring, OCR vision, Phase 03 adversarial)
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# =============================================================================
# AI — OpenAI (Phase 01 speech-to-text via Whisper)
# =============================================================================
OPENAI_API_KEY=sk-...

# =============================================================================
# File Storage
# =============================================================================
PHOTOS_BACKEND=local
DATA_LOCAL_DIR=data_local
# For Azure Blob (optional):
# PHOTOS_BACKEND=azure_blob
# AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
# AZURE_BLOB_CONTAINER=c2d2-media

# =============================================================================
# Frontend
# =============================================================================
# Same-origin is preferred in deployed frontend. Use API_INTERNAL_BASE_URL for
# Next.js server-side rewrites when the API is not on the same origin.
NEXT_PUBLIC_API_URL=
API_INTERNAL_BASE_URL=http://localhost:8000

# =============================================================================
# External Agent Services
# Keep service API keys server-side. Browser code calls /api/v1/system*/...
# SYSTEM_API_KEY is used for all three services unless a per-service key below
# overrides it.
# =============================================================================
SYSTEM_API_KEY=

SYSTEM1_INTERNAL_BASE_URL=http://c2d2-avai.staging.svc.cluster.local
SYSTEM1_API_KEY=
SYSTEM1_TIMEOUT_SECONDS=120

SYSTEM2_INTERNAL_BASE_URL=http://192.168.0.253
SYSTEM2_API_KEY=
SYSTEM2_ADMIN_API_KEY=
SYSTEM2_TIMEOUT_SECONDS=120

SYSTEM3_INTERNAL_BASE_URL=http://192.168.0.254
SYSTEM3_API_KEY=
SYSTEM3_TIMEOUT_SECONDS=120
